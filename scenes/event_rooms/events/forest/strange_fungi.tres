[gd_resource type="Resource" script_class="EventDefinition" load_steps=12 format=3]

[ext_resource type="Script" path="res://custom_resources/events/event_definition.gd" id="1_def"]
[ext_resource type="Script" path="res://custom_resources/events/event_choice.gd" id="2_choice"]
[ext_resource type="Script" path="res://custom_resources/events/event_outcome.gd" id="3_out"]

[sub_resource type="Resource" id="Outcome_1"]
script = ExtResource("3_out")
text = "It is bitter, but warmth spreads through you."
weight = 2.0
heal_share = 0.3

[sub_resource type="Resource" id="Outcome_2"]
script = ExtResource("3_out")
text = "Among the roots you find a handful of old coins."
gold = 30

[sub_resource type="Resource" id="Outcome_3"]
script = ExtResource("3_out")
text = "A sickness takes you for an hour. You recover slowly."
weight = 2.0
hp = -6

[sub_resource type="Resource" id="Outcome_4"]
script = ExtResource("3_out")
text = "Your body feels strangely sharpened."
attack = 1

[sub_resource type="Resource" id="Outcome_5"]
script = ExtResource("3_out")
text = "Nothing happens."

[sub_resource type="Resource" id="Outcome_6"]
script = ExtResource("3_out")
text = "You do not trust what you cannot name."

[sub_resource type="Resource" id="Choice_1"]
script = ExtResource("2_choice")
label = "Eat one"
outcomes = Array[ExtResource("3_out")]([SubResource("Outcome_1"), SubResource("Outcome_2"), SubResource("Outcome_3"), SubResource("Outcome_4"), SubResource("Outcome_5")])

[sub_resource type="Resource" id="Choice_2"]
script = ExtResource("2_choice")
label = "Leave them"
outcomes = Array[ExtResource("3_out")]([SubResource("Outcome_6")])

[resource]
script = ExtResource("1_def")
title = "Strange Fungi"
body = "A ring of unfamiliar fungi grows at the base of an old tree."
choices = Array[ExtResource("2_choice")]([SubResource("Choice_1"), SubResource("Choice_2")])
