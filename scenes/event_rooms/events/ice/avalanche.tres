[gd_resource type="Resource" script_class="EventDefinition" format=3 uid="uid://bgkcdckdfrlqc"]

[ext_resource type="Script" uid="uid://desiy8wf3acbw" path="res://custom_resources/events/event_definition.gd" id="1_def"]
[ext_resource type="Script" uid="uid://yye6j07ydsqo" path="res://custom_resources/events/event_choice.gd" id="2_choice"]
[ext_resource type="Script" uid="uid://cjo14r42mr810" path="res://custom_resources/events/event_outcome.gd" id="3_out"]

[sub_resource type="Resource" id="Outcome_1"]
script = ExtResource("3_out")
text = "You weather the slide and find coins in the snow."
gold = 20

[sub_resource type="Resource" id="Outcome_2"]
script = ExtResource("3_out")
text = "The slide buries you. You dig out slowly."
hp = -9

[sub_resource type="Resource" id="Choice_1"]
script = ExtResource("2_choice")
label = "Brace behind your guard"
check_stat = 2
check_base = 0.3
check_per_point = 0.04
outcomes = Array[ExtResource("3_out")]([SubResource("Outcome_1"), SubResource("Outcome_2")])

[sub_resource type="Resource" id="Outcome_3"]
script = ExtResource("3_out")
text = "You clear the slide and find a hidden path."
rerolls = 1

[sub_resource type="Resource" id="Outcome_4"]
script = ExtResource("3_out")
text = "The snow catches you before you reach safety."
hp = -9

[sub_resource type="Resource" id="Choice_2"]
script = ExtResource("2_choice")
label = "Run for open ground"
check_stat = 3
check_base = 0.2
check_per_point = 0.12
outcomes = Array[ExtResource("3_out")]([SubResource("Outcome_3"), SubResource("Outcome_4")])

[sub_resource type="Resource" id="Outcome_5"]
script = ExtResource("3_out")
text = "You find shelter and recover."
hp = 5

[sub_resource type="Resource" id="Choice_3"]
script = ExtResource("2_choice")
label = "Dig in and wait (-1 reroll)"
cost_rerolls = 1
outcomes = Array[ExtResource("3_out")]([SubResource("Outcome_5")])

[resource]
script = ExtResource("1_def")
title = "The Avalanche"
body = "A low rumble echoes down the mountain. The snow above you begins to move."
choices = Array[ExtResource("2_choice")]([SubResource("Choice_1"), SubResource("Choice_2"), SubResource("Choice_3")])
