[gd_resource type="Resource" script_class="EventDefinition" load_steps=12 format=3]

[ext_resource type="Script" path="res://custom_resources/events/event_definition.gd" id="1_def"]
[ext_resource type="Script" path="res://custom_resources/events/event_choice.gd" id="2_choice"]
[ext_resource type="Script" path="res://custom_resources/events/event_outcome.gd" id="3_out"]

[sub_resource type="Resource" id="Outcome_1"]
script = ExtResource("3_out")
text = "You carry it out through the smoke. Its lessons sharpen you."
hp = -6
attack = 1

[sub_resource type="Resource" id="Outcome_2"]
script = ExtResource("3_out")
text = "Its lessons steady your guard."
hp = -6
block = 1

[sub_resource type="Resource" id="Outcome_3"]
script = ExtResource("3_out")
text = "Its lessons quicken you."
hp = -6
speed = 1

[sub_resource type="Resource" id="Outcome_4"]
script = ExtResource("3_out")
text = "You find a few scorched coins and breathe smoke for them."
gold = 5
hp = -3

[sub_resource type="Resource" id="Choice_1"]
script = ExtResource("2_choice")
label = "Save the book on war (-6 HP)"
outcomes = Array[ExtResource("3_out")]([SubResource("Outcome_1")])

[sub_resource type="Resource" id="Choice_2"]
script = ExtResource("2_choice")
label = "Save the book on defense (-6 HP)"
outcomes = Array[ExtResource("3_out")]([SubResource("Outcome_2")])

[sub_resource type="Resource" id="Choice_3"]
script = ExtResource("2_choice")
label = "Save the book on movement (-6 HP)"
outcomes = Array[ExtResource("3_out")]([SubResource("Outcome_3")])

[sub_resource type="Resource" id="Choice_4"]
script = ExtResource("2_choice")
label = "Search the ashes"
outcomes = Array[ExtResource("3_out")]([SubResource("Outcome_4")])

[resource]
script = ExtResource("1_def")
title = "The Burning Archive"
body = "An archive burns around you. Three volumes can still be saved before the shelves fall."
choices = Array[ExtResource("2_choice")]([SubResource("Choice_1"), SubResource("Choice_2"), SubResource("Choice_3"), SubResource("Choice_4")])
